NF_CLIENT_ID=your-client-id
NF_CLIENT_SECRET=your-client-secret
# NF_WORKSPACE_ID=optional — auto-discovered from service account
# NF_DEFAULT_MODEL=claude-sonnet-5.5
# NF_MODEL_MAP=local-name:upstream-name,cheap:gpt-4.1-mini
# Default reasoning effort when the client sends none: max / xhigh / high / medium / low / minimal / none
# NF_REASONING_EFFORT=medium
# Auto-continue / retry replies cut off by neuroflash's ~150s stream limit (0 = disable)
# NF_MAX_CONTINUE=5
# Listen address (127.0.0.1 = this PC only, 0.0.0.0 = whole network)
# NF_HOST=127.0.0.1